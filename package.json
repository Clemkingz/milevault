{
  "name": "milevault",
  "private": true,
  "description": "Milestone-based escrow payments on Stellar (Soroban) \u2014 frontend monorepo",
  "packageManager": "pnpm@12.14.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter \"./apps/*\" dev",
    "dev:web": "pnpm --filter @milevault/web dev",
    "dev:app": "pnpm --filter @milevault/app dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "contract:build": "cd contracts && stellar contract build",
    "contract:test": "cd contracts && cargo test",
    "contract:deploy": "bash scripts/deploy-testnet.sh",
    "contract:bindings": "bash scripts/generate-bindings.sh",
    "dev:admin": "pnpm --filter @milevault/admin dev"
  },
  "devDependencies": {
    "typescript": "^5.9.3"
  }
}
