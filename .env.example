# MileVault frontend environment. Nothing is required for demo mode.
# On Vercel, set these once at the project level (shared by the web, app and admin services).
# Locally, copy into apps/<name>/.env.local as needed.

# ── Shared ────────────────────────────────────────────────────────────────
# Optional. Defaults to "live" when NEXT_PUBLIC_API_URL is set, otherwise "mock" (in-browser demo).
# Set "mock" explicitly to force demo mode even with an API URL.
NEXT_PUBLIC_DATA_SOURCE=
# Public domain (canonical URLs, sitemap, OG images, share links). Falls back to the Vercel URL.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# External MileVault API, with or without /api/v1. Setting it switches the apps to live mode.
# The API must allow this site's origin in its CORS settings.
NEXT_PUBLIC_API_URL=

# ── Stellar (Testnet only for the MVP) ────────────────────────────────────
# The passphrase, asset, arbiter and Horizon URL come from the API (/escrow/config, /stellar/network).
NEXT_PUBLIC_STELLAR_NETWORK=testnet
# Reown (WalletConnect) project ID from dashboard.reown.com: how phones connect to the Varial app.
# Optional: MileVault's own ID is built in as the default; set this only to use a different project.
# Add every domain that serves the app (localhost, Vercel) to the project's allowed domains in Reown.
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# ── Dashboard (apps/app) ──────────────────────────────────────────────────
# Where the logo / disconnect go. Defaults to "/" (same domain)
NEXT_PUBLIC_LANDING_URL=
# Opt in to the service worker during `next dev`
NEXT_PUBLIC_PWA_DEV=

# ── Local dev only (apps/web) ─────────────────────────────────────────────
# Where `pnpm dev` proxies /app, /a/* and /admin. On Vercel, vercel.json routing is used instead.
LOCAL_APP_URL=http://localhost:3001
LOCAL_ADMIN_URL=http://localhost:3002
