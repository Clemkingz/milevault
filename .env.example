# ── Stellar network (Testnet only for the MVP) ─────────────────────────────
STELLAR_NETWORK=testnet
STELLAR_NETWORK_PASSPHRASE="Test SDF Network ; September 2015"
SOROBAN_RPC_URL=https://soroban-testnet.stellar.org
HORIZON_URL=https://horizon-testnet.stellar.org

# Filled in after `pnpm contract:deploy`
ESCROW_CONTRACT_ID=
# Testnet USDC (Stellar Asset Contract address) used for escrow
USDC_TOKEN_CONTRACT_ID=

# ── Frontend: apps/app (copy to apps/app/.env.local) ──────────────────────
# "mock" = in-browser demo chain with simulated wallet (default); "live" = Soroban + API
NEXT_PUBLIC_DATA_SOURCE=mock
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_STELLAR_NETWORK=testnet
NEXT_PUBLIC_STELLAR_NETWORK_PASSPHRASE="Test SDF Network ; September 2015"
NEXT_PUBLIC_SOROBAN_RPC_URL=https://soroban-testnet.stellar.org
NEXT_PUBLIC_HORIZON_URL=https://horizon-testnet.stellar.org
NEXT_PUBLIC_ESCROW_CONTRACT_ID=
NEXT_PUBLIC_USDC_TOKEN_CONTRACT_ID=
NEXT_PUBLIC_API_URL=http://localhost:4000
# Where the logo / disconnect go. Defaults to "/" (same origin via the landing proxy)
NEXT_PUBLIC_LANDING_URL=
# Opt in to the service worker during `next dev`
NEXT_PUBLIC_PWA_DEV=

# ── Landing: apps/web (copy to apps/web/.env.local) ───────────────────────
# NEXT_PUBLIC_SITE_URL (above) is also used for canonical URLs, sitemap and OG images
# Dashboard deployment that /app and /a/* are proxied to (REQUIRED on Vercel)
APP_URL=http://localhost:3001

# ── Backend: apps/api (copy to apps/api/.env) ─────────────────────────────
PORT=4000
DATABASE_URL=postgres://milevault:milevault@localhost:5432/milevault
CORS_ORIGIN=http://localhost:3000,http://localhost:3001
INDEXER_ENABLED=true
INDEXER_POLL_INTERVAL_MS=6000
# Ledger to start indexing from on first run (contract deployment ledger)
INDEXER_START_LEDGER=
