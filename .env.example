# MileVault frontend environment. Nothing is required for demo mode.
# On Vercel, set these once at the project level (shared by the web, app and admin services).
# Locally, copy into apps/<name>/.env.local as needed.

# ── Shared ────────────────────────────────────────────────────────────────
# "mock" = demo data (default); "live" = external backend + Soroban contract
NEXT_PUBLIC_DATA_SOURCE=mock
# Public domain (canonical URLs, sitemap, OG images, share links). Falls back to the Vercel URL.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# External MileVault backend (separate service, not in this repo) — required for "live"
NEXT_PUBLIC_API_URL=

# ── Stellar (Testnet only for the MVP) ────────────────────────────────────
NEXT_PUBLIC_STELLAR_NETWORK=testnet
NEXT_PUBLIC_STELLAR_NETWORK_PASSPHRASE="Test SDF Network ; September 2015"
NEXT_PUBLIC_SOROBAN_RPC_URL=https://soroban-testnet.stellar.org
NEXT_PUBLIC_HORIZON_URL=https://horizon-testnet.stellar.org
# After `pnpm contract:deploy`
NEXT_PUBLIC_ESCROW_CONTRACT_ID=
# Testnet USDC (Stellar Asset Contract address)
NEXT_PUBLIC_USDC_TOKEN_CONTRACT_ID=

# ── Dashboard (apps/app) ──────────────────────────────────────────────────
# Where the logo / disconnect go. Defaults to "/" (same domain)
NEXT_PUBLIC_LANDING_URL=
# Opt in to the service worker during `next dev`
NEXT_PUBLIC_PWA_DEV=

# ── Local dev only (apps/web) ─────────────────────────────────────────────
# Where `pnpm dev` proxies /app, /a/* and /admin. On Vercel, vercel.json routing is used instead.
LOCAL_APP_URL=http://localhost:3001
LOCAL_ADMIN_URL=http://localhost:3002

# ── Contract deploy script (scripts/deploy-testnet.sh) ────────────────────
STELLAR_NETWORK=testnet
SOURCE_ACCOUNT=milevault-deployer
