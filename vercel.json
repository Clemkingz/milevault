{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "web": {
      "root": "apps/web",
      "framework": "nextjs"
    },
    "app": {
      "root": "apps/app",
      "framework": "nextjs"
    },
    "admin": {
      "root": "apps/admin",
      "framework": "nextjs"
    }
  },
  "rewrites": [
    { "source": "/app", "destination": { "service": "app" } },
    { "source": "/app/(.*)", "destination": { "service": "app" } },
    { "source": "/a/(.*)", "destination": { "service": "app" } },
    { "source": "/admin", "destination": { "service": "admin" } },
    { "source": "/admin/(.*)", "destination": { "service": "admin" } },
    { "source": "/(.*)", "destination": { "service": "web" } }
  ]
}
